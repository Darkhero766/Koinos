# Render will provide DATABASE_URL when you attach a PostgreSQL database.
DATABASE_URL=
# Supabase project values used by the API to validate browser access tokens.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Protects authority status updates. Use a long random secret.
ADMIN_KEY=change-me
# Comma-separated allowed frontend origins.
CORS_ORIGIN=https://koinos.onrender.com
